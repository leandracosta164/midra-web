        const packageId=button.dataset.package, action=button.dataset.action;
        button.disabled=true;
        try{
          let path="", body={authorized_by:currentUser};
          if(action==="readiness"){path="readiness";}
          else if(action==="advance"){path="advance";body.status=button.dataset.status;}
          else if(action==="outcome"){
            const outcome=(window.prompt("Record external outcome: ACCEPTED, RETURNED, REJECTED, or WITHDRAWN","RETURNED")||"").trim().toUpperCase();
            if(!outcome)return;
            if(!["ACCEPTED","RETURNED","REJECTED","WITHDRAWN"].includes(outcome))throw new Error("Outcome must be ACCEPTED, RETURNED, REJECTED, or WITHDRAWN.");
            body.outcome=outcome;
            body.reference=(window.prompt("External reference (optional)","")||"").trim()||null;
            body.notes=(window.prompt("Outcome notes (optional)","")||"").trim()||null;
            path="outcome";
          }
          else if(action==="return-work"){
            body.owner=(window.prompt("Return-work owner (optional)","")||"").trim()||null;
            body.due_at=(window.prompt("Return-work due date/time (optional)","")||"").trim()||null;
            body.notes=(window.prompt("Return-work notes (optional)","")||"").trim()||null;
            path="activate-return-work";
          }
          else if(action==="reassess"){path="reassess-return";}
          else if(action==="resubmit"){
            body.resubmission_note=(window.prompt("Resubmission-cycle note (optional)","")||"").trim()||null;
            path="open-resubmission";
          }
          else if(action==="close"){
            body.closure_note=(window.prompt("Closure note (optional)","")||"").trim()||null;
            path="close-accepted";
          }
          else throw new Error("Unknown submission action.");
          await api(`/engineering/jobs/${encodeURIComponent(jobNumber)}/submission-packages/${encodeURIComponent(packageId)}/${path}`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
