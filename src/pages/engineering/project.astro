            message:document.querySelector("#operation-message-input").value.trim(),
            level:document.querySelector("#operation-level").value,
            waiting_on:document.querySelector("#operation-waiting-on").value.trim()||null,
            due_at:document.querySelector("#operation-due-at").value||null,
            requires_user_action:document.querySelector("#operation-user-action").checked,
            authorized_by:currentUser
          })
        });
        const refreshed=await api(`/engineering/workspace/${encodeURIComponent(jobNumber)}`);
        operationDialog.close(); renderWorkspace(refreshed);
      }catch(error){if(error.message!=="authentication required") operationMessage.textContent=error.message;}
    });

    async function resolveSignal(signalId){
      const resolution=window.prompt("Resolution note (optional):","Completed / dependency cleared");
      if(resolution===null) return;
      try{
        await api(`/engineering/jobs/${encodeURIComponent(jobNumber)}/signals/${encodeURIComponent(signalId)}/resolve`,{
          method:"POST",headers:{"Content-Type":"application/json"},
          body:JSON.stringify({authorized_by:currentUser,resolution:resolution.trim()||null})
        });
        renderWorkspace(await api(`/engineering/workspace/${encodeURIComponent(jobNumber)}`));
      }catch(error){if(error.message!=="authentication required") window.alert(error.message);}
    }

    document.querySelector("#close-connection-dialog").addEventListener("click",()=>connectionDialog.close());
    document.querySelector("#cancel-connection").addEventListener("click",()=>connectionDialog.close());
    connectionDialog.addEventListener("click",(event)=>{if(event.target===connectionDialog) connectionDialog.close();});

    connectionForm.addEventListener("submit",async(event)=>{
      event.preventDefault();
      if(!currentWorkspace || !currentUser) return;
      confirmConnectionButton.disabled=true;
      connectionMessage.textContent="Connecting work…";
      try{
        await api(`/engineering/jobs/${encodeURIComponent(jobNumber)}/sections`,{
          method:"POST",
          headers:{"Content-Type":"application/json"},
          body:JSON.stringify({
            section:connectionSection.value,
            reference_id:connectionReference.value.trim(),
            summary:connectionDescription.value.trim() ? {description:connectionDescription.value.trim()} : {},
            authorized_by:currentUser
          })
        });
        const refreshed=await api(`/engineering/workspace/${encodeURIComponent(jobNumber)}`);
        connectionDialog.close();
        renderWorkspace(refreshed);
      }catch(error){
        if(error.message!=="authentication required") connectionMessage.textContent=error.message;
      }finally{
        confirmConnectionButton.disabled=false;
      }
    });

    stateForm.addEventListener("submit",async(event)=>{
      event.preventDefault();
      if(!currentWorkspace || !currentUser) return;
      const newState=stateSelect.value;
      const oldState=currentWorkspace.status.project_state;
      if(newState===oldState){
        stateMessage.textContent="Select a different project state.";
        return;
      }
      confirmStateButton.disabled=true;
      stateMessage.textContent="Recording state change…";
      try{
        await api(`/engineering/jobs/${encodeURIComponent(jobNumber)}/state`,{
          method:"POST",
          headers:{"Content-Type":"application/json"},
          body:JSON.stringify({
            state:newState,
            authorized_by:currentUser,
            reason:stateReason.value.trim() || null
          })
        });
        const refreshed=await api(`/engineering/workspace/${encodeURIComponent(jobNumber)}`);
        stateDialog.close();
        renderWorkspace(refreshed);
      }catch(error){
        if(error.message!=="authentication required") stateMessage.textContent=error.message;
      }finally{
        confirmStateButton.disabled=false;
      }
    });

    loadWorkspace();
  </script>
</EngineeringLayout>
