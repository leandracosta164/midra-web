    function formatBytes(value){
      const n=Number(value||0);
      if(n<1024) return `${n} B`;
      if(n<1024*1024) return `${(n/1024).toFixed(1)} KB`;
      return `${(n/1024/1024).toFixed(1)} MB`;
    }
    function fileToBase64(file){
      return new Promise((resolve,reject)=>{
        const reader=new FileReader();
        reader.onload=()=>resolve(String(reader.result).split(",")[1]||"");
        reader.onerror=()=>reject(new Error("Could not read the selected file."));
        reader.readAsDataURL(file);
      });
    }

    async function api(path,options={}){
      const response=await fetch(`${API}${path}`,{credentials:"include",...options});
      if(response.status===401){window.location.replace("/engineering/login");throw new Error("authentication required");}
      const body=await response.json().catch(()=>({}));
      if(!response.ok) throw new Error(body.detail || `API ${response.status}`);
      return body;
    }

    function eventDescription(event){
      if(event.event_type==="JOB_STATE_CHANGED"){
        const from=label(event.from_state || "UNKNOWN");
        const to=label(event.to_state || "UNKNOWN");
        return `${from} → ${to}${event.reason ? ` — ${event.reason}`:""}`;
      }
      if(event.event_type==="JOB_PROFILE_UPDATED"){
        const fields=Object.keys(event.changes||{}).map(label).join(", ");
        return `Updated ${fields || "project information"}${event.reason ? ` — ${event.reason}`:""}`;
      }
      if(event.event_type==="JOB_SECTION_CONNECTED"){
        return `${label(event.section)} → ${event.reference_id}${event.summary ? ` — ${event.summary}`:""}`;
      }
      if(event.event_type==="JOB_SIGNAL_CREATED"){
        return `${label(event.signal_type)}: ${event.summary || event.reference_id}`;
      }
      if(event.event_type==="JOB_SIGNAL_RESOLVED"){
        return `Resolved ${event.reference_id}${event.summary ? ` — ${event.summary}`:""}`;
      }
      if(event.event_type==="DELIVERABLE_CREATED"){
        return `${label(event.deliverable_type)} created: ${event.summary || event.reference_id}`;
      }
      if(event.event_type==="DELIVERABLE_STATUS_CHANGED"){
        return `${event.summary || event.reference_id}: ${label(event.from_status)} → ${label(event.to_status)}${event.document_reference ? ` · ${event.document_reference}`:""}${event.note ? ` — ${event.note}`:""}`;
      }
      if(event.event_type==="DOCUMENT_UPLOADED"){
        return `File uploaded: ${event.summary || event.reference_id} · Revision ${event.revision || 1}`;
      }
      if(event.event_type==="DOCUMENT_REVISION_UPLOADED"){
        return `New file revision: ${event.summary || event.reference_id} · Revision ${event.revision}`;
      }
      if(event.event_type==="REVIEW_CREATED") return `Review created: ${event.summary || event.reference_id}`;
      if(event.event_type==="REVIEW_COMMENT_CREATED") return `Review comment ${event.comment_number}: ${event.summary || ""}`;
      if(event.event_type==="REVIEW_COMMENT_STATUS_CHANGED") return `Review comment ${event.comment_number}: ${label(event.from_status)} → ${label(event.to_status)}`;
      if(event.event_type==="SUBMISSION_PACKAGE_CREATED") return `Submission package created: ${event.summary || event.reference_id} · ${event.recipient || ""}`;
      if(event.event_type==="SUBMISSION_PACKAGE_STATUS_CHANGED") return `Submission package ${event.summary || event.reference_id}: ${label(event.from_status)} → ${label(event.to_status)}`;
      if(event.event_type==="DEPENDENCY_CREATED") return `Dependency created: ${event.summary || event.reference_id} · Waiting on ${event.waiting_on || ""}`;
      if(event.event_type==="DEPENDENCY_STATUS_CHANGED") return `Dependency ${event.summary || event.reference_id}: ${label(event.from_status)} → ${label(event.to_status)}`;
      if(event.event_type==="ACTION_ITEM_CREATED") return `Action created: ${event.summary || event.reference_id}${event.owner ? ` · ${event.owner}`:""}`;
      if(event.event_type==="ACTION_ITEM_STATUS_CHANGED") return `Action ${event.summary || event.reference_id}: ${label(event.from_status)} → ${label(event.to_status)}`;




      return event.summary || event.reference_id || label(event.event_type || "PROJECT EVENT");
    }

    function renderWorkspace(w){
      currentWorkspace=w;
      const i=w.identity,s=w.status,a=w.activity;
      const sections=Object.keys(w.connected_sections||{});
      const events=[...(a.recent_events||[])].reverse();
      root.innerHTML=`
        <header class="job-header">
          <div><span class="job-number">${esc(i.job_number)}</span><h1>${esc(i.project_name)}</h1>
          <p>${esc(i.project_type)}${i.property_address ? ` · ${esc(i.property_address)}`:""}</p></div>
          <div class="job-header-actions">
            <div class="job-state">${esc(label(s.project_state))}</div>
            <button id="edit-project-button" class="secondary-action compact-action" type="button">Edit Project</button>
            <button id="change-state-button" class="secondary-action compact-action" type="button">Change State</button>
          </div>
        </header>
        <div class="job-summary-grid">
          <article><span>Attention</span><strong>${esc(s.attention)}</strong></article>
          <article><span>Next action</span><strong>${esc(s.next_action?.message || "No immediate action required.")}</strong></article>
          <article><span>Activity</span><strong>${esc(a.event_count)} events</strong></article>
          <article><span>Version</span><strong>${esc(s.version)}</strong></article>
        </div>
        <section class="workspace-panel operations-panel">
          <div class="panel-heading"><div><span class="panel-label">OPERATIONS</span><h2>Actions & dependencies</h2></div><button id="add-operation-button" class="primary-action compact-action" type="button">Add Item</button></div>
          <div class="operations-list">${(w.operations?.open_signals||[]).length ? (w.operations.open_signals||[]).map(signal=>`
            <article class="operation-item operation-${esc((signal.level||"NORMAL").toLowerCase())}">
              <div><span>${esc(label(signal.type))}${signal.due_at ? ` · Due ${esc(signal.due_at)}`:""}</span>
              <strong>${esc(signal.message)}</strong>
              ${signal.waiting_on ? `<small>Waiting on ${esc(signal.waiting_on)}</small>`:""}</div>
              <button class="secondary-action compact-action resolve-signal" type="button" data-signal="${esc(signal.signal_id)}">Resolve</button>
            </article>`).join("") :
            '<div class="workspace-empty"><strong>No open actions or dependencies.</strong><span>Add only the items that actually need attention or are waiting on someone.</span></div>'}
          </div>
        </section>
        <section class="workspace-panel project-brief-panel">
          <div class="panel-heading">
            <div><span class="panel-label">PROJECT BRIEF</span><h2>At-a-glance operational summary</h2></div>
            <span class="brief-state">${esc(label(w.project_brief?.workflow_state||"CLEAR"))}</span>
          </div>
