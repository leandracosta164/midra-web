---
import EngineeringLayout from "../../layouts/EngineeringLayout.astro";
---
<EngineeringLayout title="Project | MIDRA Engineering" active="projects">
  <a class="back-link" href="/engineering">← Command Center</a>
  <section id="job-workspace" class="job-workspace">
    <div class="workspace-empty"><strong>Loading project workspace…</strong><span id="loading-job">Engineering Job</span></div>
  </section>

  <dialog id="action-dialog" class="project-dialog lifecycle-dialog">
    <form id="action-form" class="project-form">
      <div class="project-dialog-heading"><div><span class="eyebrow">ACTION QUEUE</span><h2>Add action item</h2><p>Record concrete work to perform. Do not use this for passive waiting.</p></div><button id="close-action-dialog" class="dialog-close" type="button">×</button></div>
      <div class="project-form-grid">
        <label class="project-form-wide">Action<input id="action-title" required maxlength="300" placeholder="Example: Revise grading plan per Comment 4" /></label>
        <label>Type<select id="action-type"><option value="ENGINEERING">Engineering</option><option value="DRAFTING">Drafting</option><option value="REVIEW">Review</option><option value="COORDINATION">Coordination</option><option value="SUBMISSION">Submission</option><option value="ADMINISTRATIVE">Administrative</option><option value="OTHER">Other</option></select></label>
        <label>Owner <span class="field-optional">Optional</span><input id="action-owner" maxlength="300" /></label>
        <label>Due date <span class="field-optional">Optional</span><input id="action-due" type="date" /></label>
        <label>Priority<select id="action-priority"><option value="LOW">Low</option><option value="NORMAL" selected>Normal</option><option value="HIGH">High</option><option value="URGENT">Urgent</option></select></label>
        <label>Related review <span class="field-optional">Optional</span><select id="action-review"><option value="">None</option></select></label>
        <label>Related submission <span class="field-optional">Optional</span><select id="action-package"><option value="">None</option></select></label>
        <label>Related dependency <span class="field-optional">Optional</span><select id="action-dependency"><option value="">None</option></select></label>
        <label class="project-form-wide">Notes <span class="field-optional">Optional</span><textarea id="action-notes" maxlength="3000" rows="3"></textarea></label>
      </div>
      <div id="action-message" class="project-form-message"></div>
      <div class="project-form-actions"><button id="cancel-action" class="secondary-action" type="button">Cancel</button><button class="primary-action" type="submit">Add Action</button></div>
    </form>
  </dialog>

  <dialog id="action-update-dialog" class="project-dialog lifecycle-dialog">
    <form id="action-update-form" class="project-form">
      <input id="action-update-id" type="hidden" />
      <div class="project-dialog-heading"><div><span class="eyebrow">ACTION STATUS</span><h2>Update action</h2><p id="action-update-title"></p></div><button id="close-action-update-dialog" class="dialog-close" type="button">×</button></div>
      <div class="project-form-grid">
        <label>Status<select id="action-update-status"><option value="OPEN">Open</option><option value="IN_PROGRESS">In Progress</option><option value="BLOCKED">Blocked</option><option value="DONE">Done</option><option value="CANCELLED">Cancelled</option></select></label>
        <label>Priority<select id="action-update-priority"><option value="LOW">Low</option><option value="NORMAL">Normal</option><option value="HIGH">High</option><option value="URGENT">Urgent</option></select></label>
        <label>Owner <span class="field-optional">Optional</span><input id="action-update-owner" maxlength="300" /></label>
        <label>Due date <span class="field-optional">Optional</span><input id="action-update-due" type="date" /></label>
        <label class="project-form-wide">Completion / status note <span class="field-optional">Optional</span><textarea id="action-update-note" maxlength="3000" rows="3"></textarea></label>
      </div>
      <div class="professional-warning">DONE records that the work item is complete. It does not imply professional approval, agency acceptance, or project completion.</div>
      <div id="action-update-message" class="project-form-message"></div>
      <div class="project-form-actions"><button id="cancel-action-update" class="secondary-action" type="button">Cancel</button><button class="primary-action" type="submit">Save Action</button></div>
    </form>
  </dialog>

  <dialog id="dependency-dialog" class="project-dialog lifecycle-dialog">
    <form id="dependency-form" class="project-form">
      <div class="project-dialog-heading"><div><span class="eyebrow">DEPENDENCY CONTROL</span><h2>Add dependency</h2><p>Record a real external or internal item that prevents the project from moving forward.</p></div><button id="close-dependency-dialog" class="dialog-close" type="button">×</button></div>
      <div class="project-form-grid">
        <label class="project-form-wide">Dependency<input id="dependency-title" required maxlength="300" placeholder="Example: Await revised architectural plans" /></label>
        <label>Waiting on<input id="dependency-waiting-on" required maxlength="300" placeholder="Client, architect, municipality..." /></label>
        <label>Type<select id="dependency-type"><option value="EXTERNAL">External</option><option value="CLIENT">Client</option><option value="AGENCY">Agency</option><option value="CONSULTANT">Consultant</option><option value="UTILITY">Utility</option><option value="CONTRACTOR">Contractor</option><option value="INTERNAL">Internal</option><option value="OTHER">Other</option></select></label>
        <label>Due date <span class="field-optional">Optional</span><input id="dependency-due" type="date" /></label>
        <label>Follow-up date <span class="field-optional">Optional</span><input id="dependency-followup" type="date" /></label>
        <label>Related review <span class="field-optional">Optional</span><select id="dependency-review"><option value="">None</option></select></label>
        <label>Related submission <span class="field-optional">Optional</span><select id="dependency-package"><option value="">None</option></select></label>
        <label class="project-form-wide">Notes <span class="field-optional">Optional</span><textarea id="dependency-notes" maxlength="3000" rows="3"></textarea></label>
      </div>
      <div id="dependency-message" class="project-form-message"></div>
      <div class="project-form-actions"><button id="cancel-dependency" class="secondary-action" type="button">Cancel</button><button class="primary-action" type="submit">Add Dependency</button></div>
    </form>
  </dialog>

  <dialog id="dependency-update-dialog" class="project-dialog lifecycle-dialog">
    <form id="dependency-update-form" class="project-form">
      <input id="dependency-update-id" type="hidden" />
      <div class="project-dialog-heading"><div><span class="eyebrow">DEPENDENCY STATUS</span><h2>Update dependency</h2><p id="dependency-update-title"></p></div><button id="close-dependency-update-dialog" class="dialog-close" type="button">×</button></div>
      <div class="project-form-grid">
        <label>Status<select id="dependency-update-status"><option value="WAITING">Waiting</option><option value="FOLLOW_UP_DUE">Follow Up Due</option><option value="RECEIVED">Received</option><option value="RESOLVED">Resolved</option><option value="CANCELLED">Cancelled</option></select></label>
        <label>Due date <span class="field-optional">Optional</span><input id="dependency-update-due" type="date" /></label>
        <label>Follow-up date <span class="field-optional">Optional</span><input id="dependency-update-followup" type="date" /></label>
        <label class="project-form-wide">Resolution / status note <span class="field-optional">Optional</span><textarea id="dependency-update-note" maxlength="3000" rows="3"></textarea></label>
      </div>
      <div class="professional-warning">RECEIVED means the awaited item arrived. RESOLVED means the dependency no longer blocks the project. MIDRA will not infer either state.</div>
      <div id="dependency-update-message" class="project-form-message"></div>
      <div class="project-form-actions"><button id="cancel-dependency-update" class="secondary-action" type="button">Cancel</button><button class="primary-action" type="submit">Save Dependency</button></div>
    </form>
  </dialog>

  <dialog id="package-dialog" class="project-dialog lifecycle-dialog">
    <form id="package-form" class="project-form">
      <div class="project-dialog-heading"><div><span class="eyebrow">SUBMISSION CONTROL</span><h2>New submission package</h2><p>Group the exact deliverables and files intended for one recipient.</p></div><button id="close-package-dialog" class="dialog-close" type="button">×</button></div>
      <div class="project-form-grid">
        <label class="project-form-wide">Package title<input id="package-title" required maxlength="300" placeholder="Example: Planning Board Resubmission #2" /></label>
        <label>Recipient<input id="package-recipient" required maxlength="300" placeholder="Municipality, agency, client..." /></label>
        <label>Type<select id="package-type"><option value="AGENCY">Agency</option><option value="MUNICIPAL">Municipal</option><option value="CLIENT">Client</option><option value="CONTRACTOR">Contractor</option><option value="INTERNAL">Internal</option><option value="OTHER">Other</option></select></label>
        <label>Due date <span class="field-optional">Optional</span><input id="package-due" type="date" /></label>
        <label>Method <span class="field-optional">Optional</span><input id="package-method" maxlength="100" placeholder="Portal, email, hand delivery..." /></label>
        <label class="project-form-wide">Deliverables <span class="field-optional">Select one or more</span><select id="package-deliverables" multiple size="5"></select></label>
        <label class="project-form-wide">Project files <span class="field-optional">Select one or more</span><select id="package-documents" multiple size="5"></select></label>
        <label class="project-form-wide">Notes <span class="field-optional">Optional</span><textarea id="package-notes" maxlength="3000" rows="3"></textarea></label>
      </div>
      <div class="professional-warning">Creating a package does not submit, issue, transmit, or certify anything.</div>
      <div id="package-message" class="project-form-message"></div>
      <div class="project-form-actions"><button id="cancel-package" class="secondary-action" type="button">Cancel</button><button class="primary-action" type="submit">Create Package</button></div>
    </form>
  </dialog>

  <dialog id="review-dialog" class="project-dialog lifecycle-dialog">
    <form id="review-form" class="project-form">
      <div class="project-dialog-heading"><div><span class="eyebrow">REVIEW CONTROL</span><h2>Add review</h2><p>Register an agency, municipal, client, or internal review cycle.</p></div><button id="close-review-dialog" class="dialog-close" type="button">×</button></div>
      <div class="project-form-grid">
        <label class="project-form-wide">Review title<input id="review-title" required maxlength="300" placeholder="Example: Engineering Review #2" /></label>
        <label>Reviewer <span class="field-optional">Optional</span><input id="review-reviewer" maxlength="300" /></label>
        <label>Review date <span class="field-optional">Optional</span><input id="review-date" type="date" /></label>
        <label class="project-form-wide">Source project file <span class="field-optional">Optional</span><select id="review-source-document"><option value="">None</option></select></label>
      </div>
      <div id="review-message" class="project-form-message"></div>
      <div class="project-form-actions"><button id="cancel-review" class="secondary-action" type="button">Cancel</button><button class="primary-action" type="submit">Add Review</button></div>
    </form>
  </dialog>

  <dialog id="review-comment-dialog" class="project-dialog lifecycle-dialog">
    <form id="review-comment-form" class="project-form">
      <input id="review-comment-review-id" type="hidden" />
      <div class="project-dialog-heading"><div><span class="eyebrow">REVIEW COMMENT</span><h2>Add comment</h2><p id="review-comment-review-title"></p></div><button id="close-review-comment-dialog" class="dialog-close" type="button">×</button></div>
      <div class="project-form-grid">
        <label>Comment number<input id="review-comment-number" required maxlength="50" placeholder="1 or 2.a" /></label>
        <label>Discipline <span class="field-optional">Optional</span><input id="review-comment-discipline" maxlength="100" placeholder="Grading, drainage, zoning..." /></label>
        <label class="project-form-wide">Comment<textarea id="review-comment-text" required maxlength="5000" rows="4"></textarea></label>
        <label>Due date <span class="field-optional">Optional</span><input id="review-comment-due" type="date" /></label>
        <label class="professional-confirm"><input id="review-comment-action" type="checkbox" checked /> Requires action</label>
      </div>
      <div id="review-comment-message" class="project-form-message"></div>
      <div class="project-form-actions"><button id="cancel-review-comment" class="secondary-action" type="button">Cancel</button><button class="primary-action" type="submit">Add Comment</button></div>
    </form>
  </dialog>

  <dialog id="review-update-dialog" class="project-dialog lifecycle-dialog">
    <form id="review-update-form" class="project-form">
      <input id="review-update-review-id" type="hidden" /><input id="review-update-comment-id" type="hidden" />
      <div class="project-dialog-heading"><div><span class="eyebrow">COMMENT RESPONSE</span><h2 id="review-update-title">Update comment</h2><p>Track the response without automatically claiming agency acceptance.</p></div><button id="close-review-update-dialog" class="dialog-close" type="button">×</button></div>
      <div class="project-form-grid">
        <label>Status<select id="review-update-status"><option value="OPEN">Open</option><option value="IN_PROGRESS">In Progress</option><option value="RESPONDED">Responded</option><option value="VERIFIED">Verified</option><option value="NOT_APPLICABLE">Not Applicable</option></select></label>
        <label class="project-form-wide">Response<textarea id="review-update-response" maxlength="5000" rows="4"></textarea></label>
        <label class="project-form-wide">Resolution note <span class="field-optional">Optional</span><textarea id="review-update-note" maxlength="3000" rows="3"></textarea></label>
      </div>
      <div class="professional-warning">RESPONDED means a response was prepared/recorded. VERIFIED should only be selected when you have actually verified closure or acceptance.</div>
      <div id="review-update-message" class="project-form-message"></div>
      <div class="project-form-actions"><button id="cancel-review-update" class="secondary-action" type="button">Cancel</button><button class="primary-action" type="submit">Save Comment</button></div>
    </form>
  </dialog>

  <dialog id="lifecycle-audit-ack-dialog" class="project-dialog lifecycle-dialog">
    <form id="lifecycle-audit-ack-form" class="project-form">
      <div class="project-dialog-heading"><div><span class="eyebrow">READ-ONLY AUDIT REVIEW</span><h2>Acknowledge lifecycle audit</h2><p>Record that the current lifecycle audit snapshot was reviewed. This acknowledgement does not approve, certify, reopen, resolve, or otherwise change the project.</p></div><button id="close-lifecycle-audit-ack-dialog" class="dialog-close" type="button">×</button></div>
      <div class="project-form-grid"><label class="project-form-wide">Acknowledgement notes<textarea id="lifecycle-audit-ack-notes" maxlength="10000" rows="6" required placeholder="Document what was reviewed and any relevant context."></textarea></label></div>
      <div class="project-form-warning"><strong>Review record only:</strong> The acknowledgement preserves a point-in-time audit snapshot and does not substitute for any required professional or authorized human action.</div>
      <div id="lifecycle-audit-ack-message" class="project-form-message"></div><div class="project-form-actions"><button id="cancel-lifecycle-audit-ack" class="secondary-action" type="button">Cancel</button><button class="primary-action" type="submit">Record Acknowledgement</button></div>
    </form>
  </dialog>

  <dialog id="post-completion-work-dialog" class="project-dialog lifecycle-dialog">
    <form id="post-completion-work-form" class="project-form">
      <div class="project-dialog-heading"><div><span class="eyebrow">POST-COMPLETION WORK</span><h2>Add authorized work item</h2><p>Post-completion work can only be recorded after the project has been explicitly reopened.</p></div><button id="close-post-completion-work-dialog" class="dialog-close" type="button">×</button></div>
      <div class="project-form-grid"><label>Title<input id="post-completion-work-title" maxlength="300" required /></label><label>Work type<select id="post-completion-work-type"><option value="CLIENT_REQUEST">Client Request</option><option value="CORRECTION">Correction</option><option value="WARRANTY">Warranty</option><option value="AGENCY_RESPONSE">Agency Response</option><option value="ADMINISTRATIVE">Administrative</option><option value="OTHER">Other</option></select></label><label class="project-form-wide">Description<textarea id="post-completion-work-description" maxlength="10000" rows="5" required></textarea></label></div>
      <div id="post-completion-work-message" class="project-form-message"></div><div class="project-form-actions"><button id="cancel-post-completion-work" class="secondary-action" type="button">Cancel</button><button class="primary-action" type="submit">Add Work Item</button></div>
    </form>
  </dialog>
  <dialog id="post-completion-status-dialog" class="project-dialog lifecycle-dialog">
    <form id="post-completion-status-form" class="project-form">
      <input id="post-completion-status-item-id" type="hidden" />
      <div class="project-dialog-heading"><div><span class="eyebrow">POST-COMPLETION WORK</span><h2>Update work status</h2><p>Resolving post-completion work requires resolution notes.</p></div><button id="close-post-completion-status-dialog" class="dialog-close" type="button">×</button></div>
      <div class="project-form-grid"><label>Status<select id="post-completion-status"><option value="OPEN">Open</option><option value="IN_PROGRESS">In Progress</option><option value="RESOLVED">Resolved</option><option value="CANCELLED">Cancelled</option></select></label><label class="project-form-wide">Resolution notes<textarea id="post-completion-resolution-notes" maxlength="10000" rows="5"></textarea></label></div>
      <div id="post-completion-status-message" class="project-form-message"></div><div class="project-form-actions"><button id="cancel-post-completion-status" class="secondary-action" type="button">Cancel</button><button class="primary-action" type="submit">Update Status</button></div>
    </form>
  </dialog>

  <dialog id="project-reopen-dialog" class="project-dialog lifecycle-dialog">
    <form id="project-reopen-form" class="project-form">
      <div class="project-dialog-heading"><div><span class="eyebrow">POST-COMPLETION CHANGE CONTROL</span><h2>Reopen completed project</h2><p>Reopening is an explicit authorized human action. The prior completion record remains in project history.</p></div><button id="close-project-reopen-dialog" class="dialog-close" type="button">×</button></div>
      <div class="project-form-grid"><label class="project-form-wide">Reason for reopening<textarea id="project-reopen-reason" maxlength="10000" rows="6" required placeholder="Document why post-completion work requires reopening this project."></textarea></label></div>
      <div class="project-form-warning"><strong>Controlled reopening:</strong> This invalidates the active completion certification. The project must satisfy the completion gates again before it can be re-certified.</div>
      <div id="project-reopen-message" class="project-form-message"></div><div class="project-form-actions"><button id="cancel-project-reopen" class="secondary-action" type="button">Cancel</button><button class="primary-action" type="submit">Reopen Project</button></div>
    </form>
  </dialog>

  <dialog id="project-completion-dialog" class="project-dialog lifecycle-dialog">
    <form id="project-completion-form" class="project-form">
      <div class="project-dialog-heading"><div><span class="eyebrow">FINAL PROJECT CONTROL</span><h2>Certify project completion</h2><p>This is an explicit authorized human certification. MIDRA will not certify completion automatically.</p></div><button id="close-project-completion-dialog" class="dialog-close" type="button">×</button></div>
      <div class="project-form-grid"><label>Certification type<select id="project-completion-type"><option value="PROJECT_COMPLETE">Project Complete</option><option value="ADMINISTRATIVELY_CLOSED">Administratively Closed</option></select></label><label>Completion date<input id="project-completion-date" type="date" required /></label><label class="project-form-wide">Certification notes<textarea id="project-completion-notes" maxlength="10000" rows="6" required placeholder="Document the final review and basis for certification."></textarea></label></div>
      <div class="project-form-warning"><strong>Final human action:</strong> Certification is blocked while project-closure, archive, closeout, or punch-list obligations remain unresolved.</div>
      <div id="project-completion-message" class="project-form-message"></div><div class="project-form-actions"><button id="cancel-project-completion" class="secondary-action" type="button">Cancel</button><button class="primary-action" type="submit">Certify Project Completion</button></div>
    </form>
  </dialog>

  <dialog id="project-closure-dialog" class="project-dialog lifecycle-dialog">
    <form id="project-closure-form" class="project-form">
      <div class="project-dialog-heading"><div><span class="eyebrow">ADMINISTRATIVE CLOSE</span><h2>Add project closure item</h2><p>Track the final administrative obligations required to close the project record.</p></div><button id="close-project-closure-dialog" class="dialog-close" type="button">×</button></div>
      <div class="project-form-grid"><label class="project-form-wide">Title<input id="project-closure-title" required maxlength="500" /></label><label>Closure type<select id="project-closure-type"><option value="FINAL_INVOICE">Final Invoice</option><option value="CONSULTANT_CLOSEOUT">Consultant Closeout</option><option value="CLIENT_ACCEPTANCE">Client Acceptance</option><option value="PERMIT_CLOSEOUT">Permit Closeout</option><option value="RECORD_TRANSFER">Record Transfer</option><option value="LESSONS_LEARNED">Lessons Learned</option><option value="INTERNAL_ADMIN">Internal Admin</option><option value="OTHER">Other</option></select></label><label>Due date <span class="field-optional">Optional</span><input id="project-closure-due" type="date" /></label><label class="project-form-wide">Responsible party <span class="field-optional">Optional</span><input id="project-closure-responsible" maxlength="300" /></label><label class="project-form-wide">Notes <span class="field-optional">Optional</span><textarea id="project-closure-notes" maxlength="10000" rows="4"></textarea></label></div>
      <div id="project-closure-message" class="project-form-message"></div><div class="project-form-actions"><button id="cancel-project-closure" class="secondary-action" type="button">Cancel</button><button class="primary-action" type="submit">Add Closure Item</button></div>
    </form>
  </dialog>
  <dialog id="project-closure-status-dialog" class="project-dialog lifecycle-dialog">
    <form id="project-closure-status-form" class="project-form"><input id="project-closure-status-id" type="hidden" />
      <div class="project-dialog-heading"><div><span class="eyebrow">PROJECT CLOSURE CONTROL</span><h2 id="project-closure-status-title">Update closure item</h2><p>Advance administrative closeout through review and documented completion.</p></div><button id="close-project-closure-status-dialog" class="dialog-close" type="button">×</button></div>
      <div class="project-form-grid"><label>Status<select id="project-closure-status-update"><option value="OPEN">Open</option><option value="IN_PROGRESS">In Progress</option><option value="READY_FOR_REVIEW">Ready for Review</option><option value="COMPLETE">Complete</option><option value="WAIVED">Waived</option></select></label><label>Due date <span class="field-optional">Optional</span><input id="project-closure-status-due" type="date" /></label><label class="project-form-wide">Responsible party <span class="field-optional">Optional</span><input id="project-closure-status-responsible" maxlength="300" /></label><label class="project-form-wide">Completion notes <span class="field-optional">Required for complete/waived</span><textarea id="project-closure-completion-notes" maxlength="10000" rows="5"></textarea></label></div>
      <div id="project-closure-status-message" class="project-form-message"></div><div class="project-form-actions"><button id="cancel-project-closure-status" class="secondary-action" type="button">Cancel</button><button class="primary-action" type="submit">Save Closure Item</button></div>
    </form>
  </dialog>

  <dialog id="archive-record-dialog" class="project-dialog lifecycle-dialog">
    <form id="archive-record-form" class="project-form">
      <div class="project-dialog-heading"><div><span class="eyebrow">PROJECT RECORD RETENTION</span><h2>Add archive record</h2><p>Register a final project record with classification, retention date, and storage reference.</p></div><button id="close-archive-record-dialog" class="dialog-close" type="button">×</button></div>
      <div class="project-form-grid"><label class="project-form-wide">Title<input id="archive-record-title" required maxlength="500" /></label><label>Record type<select id="archive-record-type"><option value="CONTRACT">Contract</option><option value="DRAWING">Drawing</option><option value="SPECIFICATION">Specification</option><option value="CALCULATION">Calculation</option><option value="REPORT">Report</option><option value="PERMIT">Permit</option><option value="CORRESPONDENCE">Correspondence</option><option value="CLOSEOUT">Closeout</option><option value="WARRANTY">Warranty</option><option value="OTHER">Other</option></select></label><label>Retention until <span class="field-optional">Optional</span><input id="archive-record-retention" type="date" /></label><label class="project-form-wide">Storage reference <span class="field-optional">Optional until archived</span><input id="archive-record-storage" maxlength="1000" /></label><label class="project-form-wide">Notes <span class="field-optional">Optional</span><textarea id="archive-record-notes" maxlength="10000" rows="4"></textarea></label></div>
      <div id="archive-record-message" class="project-form-message"></div><div class="project-form-actions"><button id="cancel-archive-record" class="secondary-action" type="button">Cancel</button><button class="primary-action" type="submit">Add Archive Record</button></div>
    </form>
  </dialog>
  <dialog id="archive-status-dialog" class="project-dialog lifecycle-dialog">
    <form id="archive-status-form" class="project-form"><input id="archive-status-id" type="hidden" />
      <div class="project-dialog-heading"><div><span class="eyebrow">ARCHIVE CONTROL</span><h2 id="archive-status-title">Update archive record</h2><p>Advance final records through verification and controlled archival storage.</p></div><button id="close-archive-status-dialog" class="dialog-close" type="button">×</button></div>
      <div class="project-form-grid"><label>Status<select id="archive-status-update"><option value="PENDING">Pending</option><option value="READY_FOR_VERIFICATION">Ready for Verification</option><option value="VERIFIED">Verified</option><option value="ARCHIVED">Archived</option><option value="EXEMPT">Exempt</option></select></label><label>Retention until <span class="field-optional">Optional</span><input id="archive-status-retention" type="date" /></label><label class="project-form-wide">Storage reference <span class="field-optional">Required when archived</span><input id="archive-status-storage" maxlength="1000" /></label><label class="project-form-wide">Verification notes <span class="field-optional">Required for final status</span><textarea id="archive-verification-notes" maxlength="10000" rows="5"></textarea></label></div>
