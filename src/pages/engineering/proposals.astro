---
import EngineeringLayout from "../../layouts/EngineeringLayout.astro";
---
<EngineeringLayout title="Proposal Operations | MIDRA Engineering">
  <section class="workspace-heading">
    <div>
      <span class="eyebrow">PROPERTY → ENGINEERING</span>
      <h1>Proposal operations</h1>
      <p>Operate the exact Property-origin proposal lifecycle. Every professional action remains explicit and separately authorized.</p>
    </div>
    <a class="secondary-action" href="/engineering">Command Center</a>
  </section>

  <section class="proposal-layout">
    <aside class="proposal-panel">
      <div class="panel-heading"><div><span class="panel-label">QUEUE</span><h2>Property proposal requests</h2></div></div>
      <label class="filter-label">Status
        <select id="proposal-status-filter"><option value="">All statuses</option><option>REQUESTED</option><option>PROPOSAL_GENERATED</option><option>CLIENT_APPROVED</option><option>DECLINED</option><option>CANCELLED</option></select>
      </label>
      <div id="proposal-queue" class="proposal-queue"><p class="muted">Loading proposals…</p></div>
    </aside>

    <section class="proposal-panel proposal-detail">
      <div id="proposal-empty"><span class="panel-label">WORKSPACE</span><h2>Select a proposal</h2><p class="muted">Choose a Property-origin request to inspect and operate its exact lifecycle.</p></div>
      <div id="proposal-workspace" hidden>
        <div class="panel-heading"><div><span class="panel-label">EXACT PROPOSAL</span><h2 id="proposal-title">Proposal</h2></div><span id="proposal-status" class="status-chip"></span></div>
        <div id="proposal-identity" class="identity-grid"></div>
        <div id="proposal-message" class="notice" aria-live="polite"></div>

        <section class="stage" id="stage-intake"><h3>1 · Property intelligence intake</h3><div id="intake-summary" class="stage-body"></div></section>

        <section class="stage"><h3>2 · Engineering draft</h3><div id="draft-history" class="stage-body"></div>
          <form id="draft-form" class="action-form">
            <div class="form-grid"><label>Proposal number<input id="proposal-number" required maxlength="100"></label><label>Proposal date<input id="proposal-date" type="date" required></label><label class="wide">Project name<input id="project-name" maxlength="300"></label><label>Service<input id="service-name" required maxlength="300"></label><label>Price<input id="service-price" type="number" min="0" step="0.01" required></label></div>
            <label>Exclusions <small>one per line</small><textarea id="proposal-exclusions" rows="3"></textarea></label><label>Terms <small>one per line</small><textarea id="proposal-terms" rows="3"></textarea></label>
            <button class="primary-action" type="submit">Generate private draft</button>
          </form>
        </section>

        <section class="stage"><h3>3 · Engineering review</h3><div id="review-history" class="stage-body"></div></section>
        <section class="stage"><h3>4 · Authorized client release</h3><div id="release-history" class="stage-body"></div></section>
        <section class="stage"><h3>5 · Durable PDF & delivery</h3><div id="delivery-workspace" class="stage-body"></div></section>
        <section class="stage"><h3>6 · Client response</h3><div id="response-history" class="stage-body"></div></section>
        <section class="stage"><h3>7 · Authorized Engineering job creation</h3><div id="job-workspace" class="stage-body"></div></section>
      </div>
    </section>
  </section>

  <style>
    .proposal-layout{display:grid;grid-template-columns:minmax(300px,.7fr) minmax(0,1.5fr);gap:24px}.proposal-panel{background:#fff;border:1px solid #dce2e8;border-radius:16px;padding:22px}.proposal-detail{min-height:680px}.proposal-queue{display:grid;gap:10px;margin-top:16px}.proposal-row{width:100%;text-align:left;border:1px solid #dce2e8;background:#f8fafb;padding:14px;border-radius:10px;cursor:pointer}.proposal-row.active{border-color:#153f5c;background:#eef5f8}.proposal-row strong,.proposal-row span{display:block}.proposal-row span{font-size:.82rem;color:#60707c;margin-top:4px}.filter-label{display:grid;gap:6px;font-weight:700}.filter-label select,.action-form input,.action-form textarea{font:inherit;border:1px solid #bbc5cc;border-radius:8px;padding:10px}.identity-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:18px 0}.identity-grid div{padding:12px;background:#f7f9fa;border-radius:9px}.identity-grid span{display:block;color:#697781;font-size:.78rem;text-transform:uppercase;letter-spacing:.06em}.stage{border-top:1px solid #e2e7eb;padding:20px 0}.stage h3{margin:0 0 12px}.stage-body{display:grid;gap:9px}.record{border:1px solid #dce2e8;border-radius:9px;padding:12px;background:#fbfcfd}.record-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.record-actions button,.record-actions a{border:0;border-radius:8px;padding:9px 12px;font-weight:750;text-decoration:none;cursor:pointer}.record-actions button{background:#17384e;color:#fff}.record-actions .danger{background:#7c2d2d}.record-actions a{background:#edf2f5;color:#17384e}.action-form{display:grid;gap:12px;padding:14px;background:#f7f9fa;border-radius:10px;margin-top:12px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.form-grid label,.action-form>label{display:grid;gap:6px;font-weight:700}.form-grid .wide{grid-column:1/-1}.status-chip{font-size:.76rem;font-weight:800;padding:6px 10px;border-radius:999px;background:#edf2f5}.notice{min-height:24px;color:#385467;font-weight:650;margin-bottom:8px}.muted{color:#697781}.boundary{font-size:.86rem;color:#697781}.heading-actions{display:flex;gap:10px;align-items:center}@media(max-width:900px){.proposal-layout{grid-template-columns:1fr}.identity-grid,.form-grid{grid-template-columns:1fr}.form-grid .wide{grid-column:auto}}
  </style>

  <script>
    const configuredApi=document.querySelector('meta[name="midra-engineering-api-base"]')?.getAttribute("content")?.trim()||"";
    const localApiDefault=["localhost","127.0.0.1"].includes(window.location.hostname)?"http://localhost:8000":window.location.origin;
    const API=(configuredApi||localApiDefault).replace(/\/$/,"");
    const queue=document.querySelector("#proposal-queue"),filter=document.querySelector("#proposal-status-filter"),empty=document.querySelector("#proposal-empty"),workspace=document.querySelector("#proposal-workspace"),message=document.querySelector("#proposal-message");
    let selected=null;
    const text=(v,f="—")=>v===null||v===undefined||v===""?f:String(v);
    const esc=v=>{const d=document.createElement("div");d.textContent=text(v,"");return d.innerHTML};
    async function api(path,options={}){const r=await fetch(`${API}${path}`,{credentials:"include",...options});if(r.status===401){location.replace("/engineering/login");throw new Error("authentication required")};const body=await r.json().catch(()=>null);if(!r.ok)throw new Error(body?.detail||`API ${r.status}`);return body}
    const pbase=()=>`/property-records/${encodeURIComponent(selected.property_record_id)}/engineering-proposal-requests/${encodeURIComponent(selected.proposal_request_id)}`;
    function record(title,detail,actions=""){return `<div class="record"><strong>${esc(title)}</strong><div>${detail}</div>${actions?`<div class="record-actions">${actions}</div>`:""}</div>`}
    async function loadQueue(){queue.innerHTML='<p class="muted">Loading proposals…</p>';const q=new URLSearchParams({limit:"100"});if(filter.value)q.set("request_status",filter.value);try{const items=await api(`/property-records/engineering/proposal-requests?${q}`);queue.innerHTML=items.length?items.map(x=>`<button class="proposal-row" data-property="${esc(x.property_record_id)}" data-request="${esc(x.proposal_request_id)}"><strong>${esc(x.customer_name)} · ${esc(x.project_goal)}</strong><span>${esc(x.request_status)} · ${esc(x.customer_email)}</span><span>${new Date(x.created_at).toLocaleString()}</span></button>`).join(""):'<p class="muted">No Property-origin proposals in this view.</p>';queue.querySelectorAll(".proposal-row").forEach((b,i)=>b.addEventListener("click",()=>openProposal(items[i],b)))}catch(e){if(e.message!=="authentication required")queue.innerHTML=`<p class="muted">${esc(e.message)}</p>`}}
    async function openProposal(item,button){selected=item;queue.querySelectorAll(".proposal-row").forEach(x=>x.classList.remove("active"));button?.classList.add("active");empty.hidden=true;workspace.hidden=false;document.querySelector("#proposal-title").textContent=item.project_goal||"Engineering proposal";document.querySelector("#proposal-status").textContent=item.request_status||"VERIFY";document.querySelector("#proposal-identity").innerHTML=`<div><span>Customer</span><strong>${esc(item.customer_name)}</strong></div><div><span>Email</span><strong>${esc(item.customer_email)}</strong></div><div><span>Property record</span><strong>${esc(item.property_record_id)}</strong></div><div><span>Proposal request</span><strong>${esc(item.proposal_request_id)}</strong></div>`;message.textContent="Loading exact proposal lineage…";await refreshProposal()}
    async function refreshProposal(){if(!selected)return;try{const [intake,drafts,reviews,releases,deliveries,responses]=await Promise.all([api(`${pbase()}/engineering-intake`).catch(e=>({error:e.message})),api(`${pbase()}/engineering-drafts`),api(`${pbase()}/engineering-reviews`),api(`${pbase()}/engineering-releases`),api(`${pbase()}/engineering-deliveries`),api(`${pbase()}/engineering-client-responses`)]);renderIntake(intake);renderDrafts(drafts,reviews);renderReviews(reviews,releases);await renderReleases(releases,deliveries);renderResponses(responses,releases);await renderJob(responses);message.textContent="Exact durable lineage loaded. Actions below remain separately authorized."}catch(e){message.textContent=e.message}}
    function renderIntake(x){const el=document.querySelector("#intake-summary");if(x.error){el.innerHTML=record("Intake unavailable",esc(x.error));return}const w=x.workspace||{},p=w.property_record||{},v=w.verification_summary||w.verification||{};el.innerHTML=record("Exact Property lineage",`${esc(p.address||p.display_address)}<br><span class="boundary">Analysis: ${esc(x.analysis_id||x.analysis_snapshot_id)} · Verification: ${esc(v.status||"preserved")}. Property evidence remains context for Engineering review and is not automatically Engineer Accepted.</span>`)}
    function renderDrafts(drafts,reviews){const el=document.querySelector("#draft-history");el.innerHTML=drafts.length?drafts.map(d=>{const approved=reviews.some(r=>r.engineering_draft_id===d.engineering_draft_id);return record(`${d.proposal_number} · ${d.proposal_status}`,`Draft ${esc(d.engineering_draft_id)} · ${new Date(d.created_at).toLocaleString()}`,approved?"":`<button data-approve="${esc(d.engineering_draft_id)}">Approve exact draft</button>`)}).join(""):'<p class="muted">No Engineering draft yet.</p>';el.querySelectorAll("[data-approve]").forEach(b=>b.addEventListener("click",()=>approveDraft(b.dataset.approve)))}
    function renderReviews(reviews,releases){const el=document.querySelector("#review-history");el.innerHTML=reviews.length?reviews.map(r=>{const released=releases.some(x=>x.engineering_review_id===r.engineering_review_id);return record(`${r.proposal_number} · ${r.review_status}`,`Approved by ${esc(r.reviewed_by)} · ${new Date(r.created_at).toLocaleString()}`,released?"":`<button data-release="${esc(r.engineering_review_id)}">Authorize client release</button>`)}).join(""):'<p class="muted">No approved Engineering review yet.</p>';el.querySelectorAll("[data-release]").forEach(b=>b.addEventListener("click",()=>releaseReview(b.dataset.release)))}
    async function renderReleases(releases,deliveries){const rel=document.querySelector("#release-history"),dw=document.querySelector("#delivery-workspace");rel.innerHTML=releases.length?releases.map(r=>record(`${r.proposal_number} · ${r.release_status}`,`Release ${esc(r.engineering_release_id)} · ${new Date(r.created_at).toLocaleString()}`)).join(""):'<p class="muted">No authorized client release yet.</p>';if(!releases.length){dw.innerHTML='<p class="muted">Release an approved proposal before creating the durable client PDF.</p>';return}const latest=releases[0];let artifact=null;try{artifact=await api(`${pbase()}/engineering-releases/${encodeURIComponent(latest.engineering_release_id)}/proposal-pdf/metadata`)}catch{}const sent=deliveries.filter(d=>d.engineering_release_id===latest.engineering_release_id);const actions=artifact?`<a href="${API}${pbase()}/engineering-releases/${encodeURIComponent(latest.engineering_release_id)}/proposal-pdf" target="_blank" rel="noopener">Download exact PDF</a><button data-send="${esc(latest.engineering_release_id)}">Explicitly send to ${esc(selected.customer_email)}</button>`:`<button data-materialize="${esc(latest.engineering_release_id)}">Create durable exact PDF</button>`;dw.innerHTML=record(artifact?`Durable PDF · ${artifact.proposal_number}`:"Durable PDF not yet created",artifact?`${esc(artifact.filename)} · SHA-256 ${esc(artifact.pdf_sha256)}`:"The exact released proposal must be materialized before delivery.",actions)+(sent.length?sent.map(d=>record(`SENT · ${d.recipient}`,`Authorized by ${esc(d.authorized_by)} · provider message ${esc(d.provider_message_id)} · ${new Date(d.created_at).toLocaleString()}`)).join(""):"");dw.querySelector("[data-materialize]")?.addEventListener("click",e=>materializePdf(e.currentTarget.dataset.materialize));dw.querySelector("[data-send]")?.addEventListener("click",e=>sendProposal(e.currentTarget.dataset.send))}
    function renderResponses(responses,releases){const el=document.querySelector("#response-history");let html=responses.length?responses.map(r=>record(`${r.proposal_number} · ${r.response_status}`,`Recorded by ${esc(r.recorded_by)} · ${new Date(r.created_at).toLocaleString()}`)).join(""):'';if(!responses.length&&releases.length){const id=releases[0].engineering_release_id;html+=record("Record explicit client response","Only record a response actually received from the client.",`<button data-response="ACCEPTED" data-release="${esc(id)}">Record ACCEPTED</button><button class="danger" data-response="DECLINED" data-release="${esc(id)}">Record DECLINED</button>`)}el.innerHTML=html||'<p class="muted">No client response recorded.</p>';el.querySelectorAll("[data-response]").forEach(b=>b.addEventListener("click",()=>recordResponse(b.dataset.release,b.dataset.response)))}
    async function renderJob(responses){const el=document.querySelector("#job-workspace");try{const x=await api(`/engineering/property-proposals/${encodeURIComponent(selected.property_record_id)}/${encodeURIComponent(selected.proposal_request_id)}/job-creation`);el.innerHTML=record(`Engineering Job ${x.engineering_job?.job_number||x.job_creation?.engineering_job_number}`,`Created from explicit accepted proposal response. Property analysis acceptance remains separate.`,`<a href="/engineering/project?job=${encodeURIComponent(x.engineering_job?.job_number||x.job_creation?.engineering_job_number)}">Open Engineering Job</a>`);return}catch{}const accepted=responses.find(r=>r.response_status==="ACCEPTED");el.innerHTML=accepted?record("Eligible for separate job creation","Client acceptance exists. Creating the job is a distinct authorized Engineering action.",`<button data-create-job="${esc(accepted.engineering_client_response_id)}">Create Engineering Job</button>`):'<p class="muted">A recorded client acceptance is required before job creation.</p>';el.querySelector("[data-create-job]")?.addEventListener("click",e=>createJob(e.currentTarget.dataset.createJob))}
    async function action(label,fn){message.textContent=label;try{await fn();await loadQueue();await refreshSelected();}catch(e){message.textContent=e.message}}
    async function refreshSelected(){if(!selected)return;const items=await api('/property-records/engineering/proposal-requests?limit=250');selected=items.find(x=>x.proposal_request_id===selected.proposal_request_id)||selected;document.querySelector("#proposal-status").textContent=selected.request_status||"VERIFY";await refreshProposal()}
    async function approveDraft(id){if(!confirm("Approve this exact Engineering proposal draft? Approval does not send it to the client."))return;await action("Approving exact draft…",()=>api(`${pbase()}/engineering-drafts/${encodeURIComponent(id)}/approve`,{method:"POST"}))}
    async function releaseReview(id){if(!confirm("Authorize this approved proposal for client release? This still does not email the client."))return;await action("Recording authorized client release…",()=>api(`${pbase()}/engineering-reviews/${encodeURIComponent(id)}/release`,{method:"POST"}))}
    async function materializePdf(id){await action("Creating durable exact PDF artifact…",()=>api(`${pbase()}/engineering-releases/${encodeURIComponent(id)}/proposal-pdf`,{method:"POST"}))}
    async function sendProposal(id){if(!confirm(`Explicitly send the exact durable PDF to ${selected.customer_email}?`))return;await action("Sending exact durable proposal PDF…",()=>api(`${pbase()}/engineering-releases/${encodeURIComponent(id)}/deliver`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({explicit_send_authorized:true})}))}
    async function recordResponse(id,status){if(!confirm(`Record client response as ${status}? This must reflect an actual client response.`))return;await action(`Recording client response ${status}…`,()=>api(`${pbase()}/engineering-releases/${encodeURIComponent(id)}/client-response`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({response_status:status})}))}
    async function createJob(responseId){if(!confirm("Create the Engineering Job from this accepted proposal? This is a separate authorized action."))return;await action("Creating Engineering Job…",()=>api(`/engineering/property-proposals/${encodeURIComponent(selected.property_record_id)}/${encodeURIComponent(selected.proposal_request_id)}/client-responses/${encodeURIComponent(responseId)}/create-job`,{method:"POST"}))}
    document.querySelector("#draft-form").addEventListener("submit",async e=>{e.preventDefault();const lines=id=>document.querySelector(id).value.split("\n").map(x=>x.trim()).filter(Boolean);const payload={proposal_number:document.querySelector("#proposal-number").value.trim(),proposal_date:document.querySelector("#proposal-date").value,project_name:document.querySelector("#project-name").value.trim()||null,services:[{service:document.querySelector("#service-name").value.trim(),price:document.querySelector("#service-price").value}],exclusions:lines("#proposal-exclusions"),terms:lines("#proposal-terms")};await action("Generating private Engineering proposal draft…",()=>api(`${pbase()}/engineering-draft`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)}))});
    filter.addEventListener("change",loadQueue);document.querySelector("#proposal-date").value=new Date().toISOString().slice(0,10);loadQueue();
  </script>
</EngineeringLayout>
